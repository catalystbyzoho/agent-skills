{
  "name": "catalyst-by-zoho",
  "displayName": "Catalyst by Zoho",
  "version": "2.1.0",
  "description": "AI agent skill for Catalyst by Zoho — full-stack serverless cloud platform. Covers all services, SDKs, CLI, architecture patterns, pricing, migration guides, and Zoho MCP tool-based resource management.",
  "author": {
    "name": "Catalyst by Zoho",
    "email": "support@zohocatalyst.com",
    "url": "https://docs.catalyst.zoho.com/en/"
  },
  "license": "Apache-2.0",
  "keywords": [
    "catalyst",
    "zoho",
    "serverless",
    "mcp",
    "datastore",
    "zcql",
    "appsail",
    "stratus",
    "functions",
    "cloud-services"
  ],
  "rules": "./CATALYST.md",
  "skills": "./skills/",
  "commands": "./platforms/cursor/commands/",
  "hooks": "./platforms/cursor/hooks/hooks.json",
  "mcpServers": "./platforms/cursor/.mcp.json",
  "variables": {
    "type": "object",
    "properties": {
      "CATALYST_MCP_TLD": {
        "type": "string",
        "title": "Catalyst MCP data center",
        "description": "TLD for your Zoho account region (matches catalyst.zoho.<tld>). US=com, EU=eu, IN=in, AU=com.au, CA=ca, SA=sa, JP=jp, UAE=ae.",
        "enum": ["com", "eu", "in", "com.au", "ca", "sa", "jp", "ae"],
        "default": "com"
      }
    },
    "required": ["CATALYST_MCP_TLD"]
  },
  "logo": "./platforms/cursor/assets/catalyst_logo.svg",
  "homepage": "https://github.com/catalystbyzoho/agent-skills",
  "repository": "https://github.com/catalystbyzoho/agent-skills"
}
